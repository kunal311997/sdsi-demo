# ---------------------------------------------------------------------------
# URL Shortener - environment template
# Copy to `.env` and edit. Every value has a safe development default, so the
# service also runs with no .env file at all (`npm run dev`).
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development

# HTTP listener
PORT=3000
HOST=127.0.0.1

# Public base URL used when building the short link in responses.
# Set this to your real public origin in any shared environment.
BASE_URL=http://127.0.0.1:3000

# SQLite file. Use :memory: for an ephemeral database.
DATABASE_PATH=./data/links.db

# Length of generated base62 codes (6-8).
CODE_LENGTH=7

# Reject target URLs longer than this (64-8192 characters).
MAX_URL_LENGTH=2048

# Block targets that point at loopback / private / link-local hosts.
# Set to true only for trusted local demos.
ALLOW_PRIVATE_HOSTS=false

# Longest accepted expiry horizon, in days (1-3650).
EXPIRY_MAX_DAYS=3650

# Comma separated API keys. Required for writes (`POST /shorten`, `DELETE /:code`)
# and for `GET /links`. Leave empty in development to disable auth.
# In production this MUST be set.
API_KEYS=dev-key-change-me

# Require an API key to read stats too.
STATS_REQUIRE_AUTH=false

# Number of reverse proxies in front of the app (0/false = none).
TRUST_PROXY=0

# Secret salt used to HMAC client IPs before storing them in the clicks table.
# Required in production; set to a long random value.
IP_SALT=dev-only-salt

# pino log level: trace|debug|info|warn|error|fatal|silent
LOG_LEVEL=info

# Rate limits (requests per minute, per client IP)
RATE_LIMIT_GLOBAL_PER_MINUTE=300
RATE_LIMIT_WRITE_PER_MINUTE=30
RATE_LIMIT_REDIRECT_PER_MINUTE=600

# Retention for `npm run db:prune`: delete expired links older than N days.
PRUNE_AFTER_DAYS=30
